{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "total-realty-source-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "total-realty-source",
      "database_id": "b20ddd35-2a19-49c5-9b20-de33516ea67c"
    }
  ]
}
